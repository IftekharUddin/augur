# Augur CODEOWNERS
#
# Order matters: the last matching rule wins (the entire owner list is
# replaced, not merged) — same convention as upstream ZeroClaw.
#
# At founding, one maintainer holds every role (docs/governance/
# game-maintainers.md). Rules are structured now so delegation later is a
# one-line change mirrored from each game's maintainers.yaml.

# ---- Default fallback ----
* @IftekharUddin

# ---- Inherited upstream code (sync-sensitive; review for drift) ----
/crates/** @IftekharUddin
/src/** @IftekharUddin

# ---- Augur platform ----
/crates/augur-*/** @IftekharUddin
/apps/augur-desktop/** @IftekharUddin

# ---- Governance, decisions, planning ----
/docs/decisions/** @IftekharUddin
/docs/governance/** @IftekharUddin
/docs/policy/** @IftekharUddin
/planning/** @IftekharUddin

# ---- Security-sensitive paths (two-review rule per governance doc) ----
/SECURITY.md @IftekharUddin
/deny.toml @IftekharUddin
/.github/** @IftekharUddin

# ---- Games: one rule per game, mirrored from games/<id>/maintainers.yaml.
# Must come AFTER the fallback rules (last match wins). Strategy sub-rule
# comes after the game rule so strategy maintainers are additive.
/games/hearthstone-battlegrounds/** @IftekharUddin
/games/hearthstone-battlegrounds/strategies/** @IftekharUddin
